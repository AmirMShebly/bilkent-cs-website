---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/layout/PageHeader.astro';
import ArchiveItem from '@/components/archive/ArchiveItem.astro';
import Pagination from '@/components/archive/Pagination.astro';
import { languageTarget, type ArchiveRoute, type SiteIndex } from '@/lib/routes';
import { breadcrumbsFor } from '@/lib/sections';
import { categories } from '@/config/categories';
import { t } from '@/i18n/ui';

interface Props {
  route: ArchiveRoute;
  index: SiteIndex;
}

const { route, index } = Astro.props;
const { lang } = route;
const title = route.page > 1 ? `${route.title} – ${t(lang, 'archive.page', { page: route.page })}` : route.title;
---
<BaseLayout
  lang={lang}
  title={title}
  description={t(lang, 'meta.archive', { name: route.title })}
  feed={`${categories[route.category][lang].path}rss.xml`}
  alternates={index.alternates.get(route.path) ?? { [lang]: route.path }}
  switchTarget={languageTarget(index, route)}
>
  <PageHeader lang={lang} title={route.title} crumbs={breadcrumbsFor(route, index)}>
    <p class="pagehead__meta">{t(lang, 'archive.count', { count: route.total })}{route.totalPages > 1 && <> · {t(lang, 'archive.pageOf', { page: route.page, total: route.totalPages })}</>}</p>
  </PageHeader>
  <div class="container archive">
    {route.posts.length ? (
      <ol class="entries" role="list">
        {route.posts.map((post) => <li><ArchiveItem post={post} lang={lang} /></li>)}
      </ol>
    ) : (
      <p>{t(lang, 'archive.empty')}</p>
    )}
    <Pagination lang={lang} category={route.category} page={route.page} totalPages={route.totalPages} />
  </div>
</BaseLayout>
